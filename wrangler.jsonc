{
  // Имя воркера — станет частью адреса:
  // https://imagegen-connector.<ваш-поддомен>.workers.dev
  "name": "imagegen-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // KV-хранилище: OAuth-токены, картинки (30 дней), загрузки, счётчик расходов.
  // При установке кнопкой «Deploy to Cloudflare» хранилище создаётся и
  // привязывается автоматически (id ниже — заглушка, Cloudflare заменит её).
  // При ручной установке: npx wrangler kv namespace create OAUTH_KV
  // и вставьте выданный id сюда.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ]

  // Секретов нет: API-ключ OpenAI каждый пользователь вводит сам
  // на странице подключения коннектора, ключ хранится в его OAuth-гранте.
}
